# NPM configuration
#
# Publishing is done by .github/workflows/release.yaml (semantic-release), which
# points npm at the right Nexus repository per branch. Do not set a registry or
# dist-tag here: a registry would override nothing in CI but mislead locally,
# and `tag=latest` would label prereleases as latest on a manual publish.

# Pin exact versions when installing.
save-exact=true
