{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "rootDir": ".",
    "noEmit": true,
    "isolatedModules": true,
    // `.github/scripts/*.ts` is pulled in by tests and imports with `.ts` specifiers.
    "allowImportingTsExtensions": true,
    "types": ["node", "jest"]
  },
  "include": ["src/**/*", "tests/**/*"]
}